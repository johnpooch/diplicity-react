{
  "name": "evals",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "remoteEnv": {
    "EVALS_LABELLER": "${containerEnv:GITHUB_USER}"
  },
  "forwardPorts": [5176],
  "portsAttributes": {
    "5176": {
      "label": "evals UI",
      "onAutoForward": "openBrowser"
    },
    "8001": {
      "label": "evals API",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "python3 -m venv evals/.venv && evals/.venv/bin/pip install -r evals/requirements.txt -r evals/dev_requirements.txt && npm ci --prefix evals/web",
  "postAttachCommand": {
    "api": "cd evals && .venv/bin/python manage.py runserver 8001",
    "web": "cd evals/web && npm run dev"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.black-formatter", "dbaeumer.vscode-eslint"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/evals/.venv/bin/python"
      }
    }
  }
}
